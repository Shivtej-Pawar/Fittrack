# Copy this file to .env (for local overrides) or .env.production (for a
# real deployment build) and fill in real values. Vite only exposes
# variables prefixed with VITE_ to the browser bundle — see
# https://vite.dev/guide/env-and-mode

# Base URL of the FastAPI backend, including the /api/v1 prefix.
# If unset, src/api/axios.js falls back to the local-dev address below,
# so `npm run dev` works out of the box with no .env file at all.
VITE_API_URL=http://127.0.0.1:8000/api/v1

# For a production build, set this to your deployed backend's real URL, e.g.:
# VITE_API_URL=https://your-backend.onrender.com/api/v1
